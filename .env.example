# Copy to .env.local (gitignored) and fill in. Vite only exposes VITE_* vars.

# ─── Firebase (the portal's OWN project — NOT phanalytics') ───
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# DEV ONLY: point auth at the local emulator instead of the real project.
# Leave UNSET in production.
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# phcustomerapi base URL.
VITE_API_URL=http://localhost:4000
