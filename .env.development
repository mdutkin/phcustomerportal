# Dev config (loaded by Vite in `npm run dev`). NO SECRETS.
# Auth runs against the local Firebase Auth emulator — start it from the
# phcustomerapi repo with: npm run emulator
VITE_FIREBASE_PROJECT_ID=demo-medico-portal
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# phcustomerapi base URL (used by the API client / best-effort /me sync).
VITE_API_URL=http://localhost:4000
